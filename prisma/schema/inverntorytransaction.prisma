model InventoryTransaction {
  id          String           @id @default(uuid()) @db.Uuid
  materialId  String           @map("material_id") @db.Uuid
  projectId   String?          @map("project_id") @db.Uuid
  type        InventoryTxType
  quantity    Decimal          @db.Decimal(12, 2)
  note        String?          @db.Text
  performedById String        @map("performed_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  material    Material         @relation(fields: [materialId], references: [id], onDelete: Restrict)
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  performedBy User             @relation("InventoryActor", fields: [performedById], references: [id])

  @@index([materialId, createdAt])
  @@index([projectId])
  @@map("inventory_transactions")
}