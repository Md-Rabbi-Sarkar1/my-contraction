model DailyWorkReport {
  id                 String          @id @default(uuid()) @db.Uuid
  projectId          String          @map("project_id") @db.Uuid
  submittedById      String          @map("submitted_by_id") @db.Uuid
  reportDate         DateTime        @map("report_date") @db.Date
  workCompleted      String          @db.Text
  hoursWorked        Decimal         @map("hours_worked") @db.Decimal(6, 2)
  materialsUsed      String?         @map("materials_used") @db.Text
  progressPct        Int             @map("progress_pct") @default(0) @db.SmallInt
  problemsEncountered String?        @map("problems_encountered") @db.Text
  notes              String?         @db.Text
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy        User            @relation("ReportSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  workers            ReportWorker[]

  @@index([projectId])
  @@index([submittedById])
  @@index([reportDate])
  @@map("daily_work_reports")
}