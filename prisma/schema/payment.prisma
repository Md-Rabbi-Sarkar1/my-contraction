model Payment {
  id String @id @default(uuid()) @db.Uuid

  status PaymentStatus @default(UNPAID)

  amount   Decimal @db.Decimal(10, 2) // 100.50
  currency String  @default("BDT")

  paymentGateway        String @default("bkash")
  merchantInvoiceNumber String @unique //companyId

  bkashPaymentId String? @unique
  bkashTrxId     String?
  payerReference String? // user email / phone number
  paidAt         String?

  gatewayResponse Json?

  companyId String  @unique @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}